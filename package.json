{
  "name": "secondBrain",
  "private": true,
  "type": "module",
  "scripts": {
    "cleanup": "rm -rf .nuxt .output node_modules/.cache && git worktree list --porcelain | grep '^worktree' | grep -v \"$(pwd)$\" | cut -d' ' -f2 | xargs -I {} git worktree remove --force {} 2>/dev/null; rm -rf .worktrees",
    "build:excalidraw": "vp dlx tsx scripts/build-excalidraw.ts",
    "build:og": "vp dlx tsx scripts/build-og-images.ts",
    "build": "vp run build:excalidraw && vp run build:og && nuxt build",
    "dev": "rm -rf .nuxt .data && nuxt dev",
    "typecheck": "nuxt typecheck",
    "generate": "nuxt generate",
    "check": "vp check",
    "lint": "vp lint && vp run lint:es && vp run lint:md",
    "lint:fix": "vp lint --fix && eslint . --fix && markdownlint-cli2 --fix 'content/**/*.md'",
    "lint:ox": "vp lint",
    "lint:es": "eslint .",
    "lint:md": "markdownlint-cli2 'content/**/*.md'",
    "preview": "nuxt preview",
    "test:unit": "vp test --project unit",
    "test:unit:cov": "vp test --project unit --coverage",
    "test:nuxt": "vp test --project nuxt --project nuxt-browser",
    "test": "vp test --project unit --project nuxt --project nuxt-browser",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui",
    "test:a11y": "lhci autorun --config .lighthouserc.cjs",
    "test:mutation": "stryker run",
    "prepare": "vp config",
    "ralph": "./ralph/ralph.sh",
    "fix-e2e": "./ralph/fix-e2e.sh",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@nuxt/content": "^3.10.0",
    "@nuxt/fonts": "^0.12.1",
    "@nuxt/ui": "4.3.0",
    "@portaljs/remark-wiki-link": "^1.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/d3": "^7.4.3",
    "@vueuse/core": "^14.1.0",
    "@vueuse/nuxt": "^14.1.0",
    "@vueuse/router": "^14.1.0",
    "d3": "^7.9.0",
    "d3-array": "^3.2.4",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "fuse.js": "^7.1.0",
    "h3": "^1.15.5",
    "mermaid": "^11.12.2",
    "nuxt": "^4.2.2",
    "satori": "^0.18.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/markdown": "^7.5.1",
    "@iconify-json/lucide": "^1.2.98",
    "@iconify-json/simple-icons": "^1.2.71",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/kit": "^4.2.2",
    "@nuxt/test-utils": "^4.0.0",
    "@nuxtjs/html-validator": "^2.1.0",
    "@playwright/test": "^1.57.0",
    "@stryker-mutator/core": "^9.4.0",
    "@stryker-mutator/vitest-runner": "^9.4.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/d3-array": "^3.2.2",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.7",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^25.0.3",
    "@typescript-eslint/parser": "^8.32.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vite-pwa/nuxt": "^1.1.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.6",
    "eslint-plugin-vue": "^10.6.2",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "fast-check": "^4.5.3",
    "happy-dom": "^20.0.11",
    "knip": "^5.85.0",
    "lucide-static": "^0.562.0",
    "markdownlint-cli2": "^0.20.0",
    "nitropack": "^2.12.9",
    "playwright": "^1.57.0",
    "typescript-eslint": "^8.32.1",
    "unplugin-auto-import": "^20.3.0",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "vitest-axe": "^0.1.0",
    "vitest-browser-vue": "^1.1.0",
    "vue": "^3.5.27",
    "vue-eslint-parser": "^10.1.3",
    "vue-router": "^4.6.4",
    "yaml": "^2.8.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "devalue": ">=5.6.2",
      "tar": ">=7.5.3",
      "diff": ">=8.0.3",
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  }
}
